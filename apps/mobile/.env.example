# =============================================================================
# GrowGame - Variables d'environnement
# =============================================================================
#
# INSTRUCTIONS :
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Remplir les valeurs avec vos propres clés
# 3. NE JAMAIS commiter le fichier .env !
#
# =============================================================================

# =============================================================================
# Environnement
# =============================================================================
# Valeurs possibles : development, staging, production
EXPO_PUBLIC_APP_ENV=development

# =============================================================================
# Supabase
# =============================================================================
# Récupérer ces valeurs depuis le dashboard Supabase :
# https://app.supabase.com/project/[votre-projet]/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# =============================================================================
# Google Cloud Vision (optionnel - vérification photo)
# =============================================================================
# Récupérer depuis la console Google Cloud :
# https://console.cloud.google.com/apis/credentials
# Laisser vide en développement pour désactiver la vérification

# EXPO_PUBLIC_GOOGLE_VISION_API_KEY=votre-cle-api

# =============================================================================
# Feature Flags (optionnel)
# =============================================================================
# Activer/désactiver des fonctionnalités en développement

# EXPO_PUBLIC_ENABLE_DEV_MENU=true
# EXPO_PUBLIC_ENABLE_MOCK_DATA=true
